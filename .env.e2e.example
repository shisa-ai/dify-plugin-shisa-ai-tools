# Local Dify E2E environment template.
# Copy to `.env.e2e` and fill in the real values. Never commit real values.
# In GitHub Actions the same variables come from the protected `release`
# environment secrets/variables.

# Local Dify instance under test
DIFY_BASE_URL=http://localhost
DIFY_ADMIN_EMAIL=admin@shisa.ai
DIFY_ADMIN_PASSWORD=change-me
DIFY_INIT_PASSWORD=change-me

# Shisa AI API key used to configure the installed Tools plugin credentials
SHISA_API_KEY=

# Package and verified workflow DSL used by the test
PKG_PATH=E:/AI/shisa-ai-tools-1.0.2.difypkg
DSL_PATH=E:/AI/dify-shisa-ai-tools/docs/dify-smoke-test/Shisa-AI-Tools-Release-Smoke-Test.yml

# Model Provider E2E
MODEL_PKG_PATH=E:/AI/shisa-ai-1.0.2.difypkg
MODEL_DSL_PATH=E:/AI/dify-shisa-ai-tools/docs/dify-smoke-test/Shisa-Model-Provider-E2E.yml
AUDIO_PATH=E:/AI/shisa-brand-spoken-ja.wav
